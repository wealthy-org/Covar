{
  "name": "covar",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "postinstall": "node scripts/postinstall.mjs",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/engine.test.ts",
    "test:integration": "tsx tests/services/reconciliation.test.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "compile": "node scripts/hardhat.mjs compile",
    "test:contracts": "node scripts/hardhat.mjs test",
    "preflight:testnet": "node scripts/hardhat.mjs run scripts/preflight.ts --network robinhoodTestnet",
    "preflight:mainnet": "node scripts/hardhat.mjs run scripts/preflight.ts --network robinhoodMainnet",
    "deploy:testnet": "node scripts/hardhat.mjs run scripts/deploy.ts --network robinhoodTestnet",
    "deploy:mainnet": "node scripts/hardhat.mjs run scripts/deploy.ts --network robinhoodMainnet",
    "verify:testnet": "node scripts/verify-blockscout.mjs 46630",
    "verify:mainnet": "node scripts/verify-blockscout.mjs 4663",
    "test:all": "npm run test && npm run test:services && npm run test:contracts && npm run test:e2e",
    "deploy:local": "node scripts/hardhat.mjs run scripts/deploy-local.ts --network localhost",
    "test:services": "tsx tests/services/reconciliation.test.ts && tsx tests/services/lighter.test.ts && tsx tests/services/operator.test.ts && tsx tests/services/auth.test.ts && tsx tests/services/indexer.test.ts && tsx tests/services/credits.test.ts",
    "services": "tsx scripts/run-services.ts",
    "ops": "tsx scripts/run-services.ts --only operator,monitor",
    "demo:reconcile": "tsx scripts/demo-reconcile.ts",
    "indexer": "tsx services/indexer/main.ts",
    "rehearse:e2e": "node scripts/hardhat.mjs run scripts/e2e-rehearsal.ts --network localhost",
    "test:e2e": "playwright test",
    "test:lighter": "tsx tests/services/lighter.test.ts",
    "operator": "tsx services/operator/main.ts",
    "monitor": "tsx services/monitor/main.ts",
    "test:operator": "tsx tests/services/operator.test.ts",
    "test:auth": "tsx tests/services/auth.test.ts",
    "test:e2e:invest": "node scripts/e2e-invest.mjs",
    "test:e2e:trade": "node scripts/e2e-trade.mjs",
    "db:pg:generate": "node scripts/prisma-pg.mjs generate",
    "db:pg:deploy": "node scripts/prisma-pg.mjs migrate deploy",
    "db:pg:check": "node scripts/prisma-pg.mjs check",
    "test:indexer": "tsx tests/services/indexer.test.ts",
    "test:credits": "tsx tests/services/credits.test.ts",
    "cli": "node cli/run.js",
    "test:intent": "tsx tests/stockIntent.test.ts",
    "test:trade": "tsx tests/stockTrade.test.ts",
    "test:contracts:fork": "HARDHAT_FORK_URL=https://rpc.mainnet.chain.robinhood.com node scripts/hardhat.mjs test tests/contracts/CovarStockRouter.fork.test.ts",
    "deploy:router": "node scripts/hardhat.mjs run scripts/deploy-router.ts",
    "verify:router": "node scripts/verify-blockscout.mjs 4663 --router"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "geist": "^1.9.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "chai": "^4.5.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.5.29",
    "hardhat": "^2.22.17",
    "playwright": "^1.64.1",
    "prisma": "^6.18.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.0.0"
}

{
  "name": "covar",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "postinstall": "node scripts/setup-env.mjs && prisma generate",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/engine.test.ts",
    "test:integration": "tsx tests/services/reconciliation.test.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "compile": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat compile",
    "test:contracts": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test",
    "preflight:testnet": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/preflight.ts --network robinhoodTestnet",
    "preflight:mainnet": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/preflight.ts --network robinhoodMainnet",
    "deploy:testnet": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network robinhoodTestnet",
    "deploy:mainnet": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network robinhoodMainnet",
    "test:all": "npm run test && npm run test:services && npm run test:contracts && npm run test:e2e",
    "deploy:local": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy-local.ts --network localhost",
    "test:services": "tsx tests/services/reconciliation.test.ts",
    "services": "tsx scripts/run-services.ts",
    "demo:reconcile": "tsx scripts/demo-reconcile.ts",
    "indexer": "tsx services/indexer/main.ts",
    "rehearse:e2e": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/e2e-rehearsal.ts --network localhost",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "dotenv": "^16.4.5",
    "geist": "^1.9.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "chai": "^4.5.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.5.29",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.17",
    "playwright": "^1.64.1",
    "prisma": "^6.18.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.0.0"
}
# dependencies & build output (regenerable from pnpm-lock.yaml)
node_modules/
.next/
artifacts/
cache/

# runtime state of the execution plane & rehearsals (session-local, must never travel)
.covar-state*/
test-results/
playwright-report/

# secrets — never committed; keys selalu lewat environment
.env
.env.*
# the template has no secrets and fresh clones need it (postinstall copies it to .env)
!.env.example
*.key
*.pem

# Prisma session database (regenerable via `pnpm exec prisma migrate deploy`)
prisma/dev.db*

# TS incremental build cache (regenerated)
tsconfig.tsbuildinfo

contracts
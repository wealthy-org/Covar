// Covar application storage — Prisma over SQLite by default.
//
// This is the durable home for web-side records the brief requires (§8): users,
// strategy versions, practice runs, ledger rows, credits and notifications.
// The execution plane intentionally keeps its OWN journals (separate processes,
// separate audit trails) — this DB never holds order state, and the services never
// read from it. Switch provider to postgresql for a shared deployment; the schema
// uses no SQLite-specific types.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env(DATABASE_URL=postgresql://neondb_owner:npg_XMlPrY06LcDA@ep-young-sunset-azit8oem-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=requires)
}

// Whole-session snapshot, synced from the client store. One row per device-session
// in this single-operator review build; it stores the JSON verbatim so app version
// changes never require a column migration just to load older state.
model SessionState {
  id        String   @id @default("local")
  savedAt   DateTime @updatedAt
  stateJson String
}

// A notification, durable across reloads. Written only by real state transitions —
// never by marketing copy.
model Notification {
  id        String   @id
  ts        DateTime
  kind      String // practice | publish | money | risk | copilot | system
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  sessionId String   @default("local")

  @@index([sessionId, ts])
}

// Append-only money/AI ledger rows. The chain ledger is the contract; this is the
// web-side record for the session — labelled simulated until deposits settle on-chain.
model LedgerEntry {
  id        String   @id
  ts        DateTime
  kind      String // deposit | withdrawal_request | withdrawal_claim | trade_fee | ai_credit
  agentId   String?
  label     String
  amountUsd Float
  state     String // pending | settled | failed
  txHash    String? // only ever populated with a hash returned by a chain RPC
  note      String?
  sessionId String  @default("local")

  @@index([sessionId, ts])
}

// Strategy drafts and published versions. Version history is first-class: a row is
// immutable once `publishedAt` is set; edits create a new row.
model StrategyVersion {
  id         String    @id
  agentId    String
  version    Int
  name       String
  rulesJson  String
  publishedAt DateTime?
  createdAt  DateTime  @default(now())
  sessionId  String    @default("local")

  @@unique([agentId, version, sessionId])
}

// Practice runs with their price-mode provenance (live marks vs simulated ticks).
model PracticeRun {
  agentId     String   @id
  startedAt   DateTime
  capitalUsd  Float
  pnlUsd      Float    @default(0)
  ticks       Int      @default(0)
  status      String   // running | stopped
  priceMode   String   // live | simulated
  entryPrice  Float?
  lastPrice   Float?
  priceSource String?
  sessionId   String   @default("local")

  @@index([sessionId])
}

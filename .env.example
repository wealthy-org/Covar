# ─────────────────────────────────────────────────────────────────────────────
# Covar — environment template. Copy to .env.local. NEVER commit real secrets.
# Key naming follows the reference repo (github.com/wealthy-org/Covar).
# ─────────────────────────────────────────────────────────────────────────────

# --- app identity (public) ---------------------------------------------------
NEXT_PUBLIC_APP_NAME=Covar
# practice | testnet | mainnet — UI labeling/indicator behaviour.
NEXT_PUBLIC_APP_ENV=practice
# practice | testnet | mainnet — which chain the UI expects.
NEXT_PUBLIC_CHAIN_ENV=practice

# --- Robinhood chain endpoints (public) --------------------------------------
NEXT_PUBLIC_RH_TESTNET_CHAIN_ID=46630
NEXT_PUBLIC_RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_RH_MAINNET_CHAIN_ID=4663
NEXT_PUBLIC_RH_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- this build's extensions (public) ----------------------------------------
# Vault address produced by scripts/deploy.ts (deployments/<chainId>.json).
# Leave empty to run the simulated ledger — the UI labels itself "Simulated".
NEXT_PUBLIC_COVAR_VAULT_ADDRESS=
# Wallet adapter: session | evm (default: session). Privy is spec-only here.
# Use evm for real users (MetaMask/Rabby + Sign-In with Ethereum).
NEXT_PUBLIC_WALLET_PROVIDER=session
# Local Hardhat node for the dev chain (31337).
NEXT_PUBLIC_LOCAL_RPC=http://127.0.0.1:8545

# --- database (server-side; Prisma) ------------------------------------------
DATABASE_URL=file:./dev.db
# (sqlite path is resolved relative to prisma/schema.prisma)
# Shared/multi-user deployment: PostgreSQL, e.g.
#   DATABASE_URL=postgresql://covar:PASSWORD@HOST:5432/covar
# then: pnpm db:pg:generate && pnpm db:pg:deploy (before next build/start)
# Migration/shadow URL (pg-style in the reference repo; unused with SQLite here).
DIRECT_URL=

# --- AI copilot (server-side) -------------------------------------------------
# orbio | anthropic | openai — optional, inferred from the key prefix
# (sk-orbio-… → Orbio, sk-ant-… → Anthropic, sk-… → OpenAI).
AI_PROVIDER=
# Orbio key: orbio.so/dashboard → API keys. Empty = labelled rules parser.
AI_PROVIDER_API_KEY=
# Optional model id. Orbio catalogue: https://api.orbio.so/api/v1/models
# (default Orbio: anthropic/claude-haiku-4.5).
AI_MODEL=
# Optional gateway override for OpenAI-compatible providers.
AI_BASE_URL=

# --- execution plane (server-side) -------------------------------------------
# Signing key used by the executor service when anchoring to chain.
TRADING_SIGNER_PRIVATE_KEY=

# --- deployment (server-side only; keep out of version control) --------------
DEPLOYER_KEY=
OPERATOR_ADDRESS=
FEE_RECIPIENT_ADDRESS=
# Testnet USDG (Paxos-published, 6 decimals): 0x7E955252E15c84f5768B83c41a71F9eba181802F
# Leave empty to use that default on testnet / the docs.robinhood.com address on mainnet.
USDG_ADDRESS=
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
# Mainnet deployment is refused unless this is exactly "yes".
CONFIRM_MAINNET=

# --- operator service (wallet B automation, package 3.3) — server-side only ---
# Dry-run by default: plans and journals every cycle, sends nothing.
OPERATOR_MODE=dry-run
# Required only for OPERATOR_MODE=live. Wallet B (the vault's `operator`). Never commit.
OPERATOR_PRIVATE_KEY=
# Vault to operate (falls back to NEXT_PUBLIC_COVAR_VAULT_ADDRESS).
OPERATOR_VAULT_ADDRESS=
# testnet | mainnet (needs OPERATOR_MAINNET_CONFIRM=yes) | local; or OPERATOR_RPC_URL.
OPERATOR_CHAIN=testnet
OPERATOR_MAINNET_CONFIRM=
OPERATOR_INTERVAL_SEC=60
# Venue equity source: none (vault-only NAV) | manual (+ OPERATOR_VENUE_EQUITY_USDG) | lighter (uses LIGHTER_NETWORK + LIGHTER_ACCOUNT_INDEX, read-only)
OPERATOR_VENUE=none
OPERATOR_VENUE_EQUITY_USDG=
# Withdrawal close step: execution (EXEC_URL) | no-positions | manual. Default follows OPERATOR_VENUE.
OPERATOR_CLOSE=
EXEC_URL=http://127.0.0.1:4010
# NAV policy (defaults: refresh at maxNavAge/2, report when moved >= 50 bps, hold above 500 bps)
OPERATOR_NAV_REFRESH_SEC=
OPERATOR_MIN_CHANGE_BPS=
OPERATOR_MAX_AUTO_CHANGE_BPS=
OPERATOR_IN_TRANSIT_USDG=
# Return path venue → wallet B → vault. "yes" also counts wallet B's USDG in NAV (wallet B must hold vault capital only).
OPERATOR_AUTO_FUND=
OPERATOR_WALLET_IN_NAV=
# Optional: move idle USDG above a reserve to the owner-set trading account (v2 vault).
OPERATOR_AUTO_ALLOCATE=
OPERATOR_IDLE_RESERVE_BPS=2000
OPERATOR_MIN_ALLOCATE_USDG=10
OPERATOR_TRANSIT_TIMEOUT_SEC=3600
OPERATOR_MIN_GAS_ETH=0.00005

# --- monitoring / alerts (package 3.10) — server-side only --------------------
# Telegram: create a bot with @BotFather, message it once, then read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates. Never commit the token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SEC=1800
MONITOR_INTERVAL_SEC=60
MONITOR_HEARTBEAT_HOURS=24
MONITOR_WITHDRAWAL_SLA_HOURS=24
# name=url,... (default: every service started by `pnpm services`)
MONITOR_TARGETS=

# --- accounts / Sign-In with Ethereum (package 3.2) — server-side -------------
# Public origin of the site; SIWE messages are bound to it. Set in production
# (e.g. https://covar.example). Empty = taken from the request Host header.
APP_ORIGIN=
SESSION_TTL_HOURS=168
# Lax (default). Use None only if the app must work inside a cross-site iframe.
SESSION_COOKIE_SAMESITE=
# Anonymous server-side state: local (dev default, one shared row) | off (production default).
STATE_ANON_MODE=
# Accept chain 31337 sign-ins in production builds (local rehearsal only).
ALLOW_LOCAL_CHAIN=

# --- vault indexer (package 3.6) — server-side --------------------------------
# Reads the vault's event logs + USDG transfers; feeds Discover, the on-chain agent
# record and the treasury page through /api/vault/summary. Started by
# `pnpm services` when a vault address is set. Vault = INDEXER_VAULT_ADDRESS, else
# OPERATOR_VAULT_ADDRESS, else NEXT_PUBLIC_COVAR_VAULT_ADDRESS.
INDEXER_PORT=4016
# Where the web app reaches the indexer (server-side only, never the browser).
INDEXER_URL=http://127.0.0.1:4016
# testnet | mainnet | local (defaults to OPERATOR_CHAIN), or an explicit RPC:
INDEXER_CHAIN=
INDEXER_RPC_URL=
# First block to scan (the vault's deployment block). Empty = found automatically.
INDEXER_START_BLOCK=
INDEXER_CHUNK=5000
# Optional labels for the on-chain vault record
NEXT_PUBLIC_COVAR_VAULT_NAME=
NEXT_PUBLIC_COVAR_VAULT_MARKET=

# --- Copilot credits (package 3.7) — server-side -------------------------------
# enforce: model calls need a signed-in wallet with credits (production default)
# off:     model calls are free (dev default). The rules parser is always free.
CREDITS_MODE=
# Top-ups are USDG transfers to this address, verified on-chain by the server.
# Use a wallet you control (e.g. the treasury/fee wallet C). Empty = top-ups off.
CREDITS_TREASURY_ADDRESS=
# Chain for top-ups (defaults to NEXT_PUBLIC_RH_CHAIN_ID); USDG is known for
# 46630 and 4663, set CREDITS_USDG_ADDRESS only for other chains.
CREDITS_CHAIN_ID=
CREDITS_RPC_URL=
CREDITS_USDG_ADDRESS=
CREDITS_MIN_CONFIRMATIONS=1
CREDITS_MIN_TOPUP_USD=1
CREDITS_MAX_TOPUP_USD=500
# Balance a call needs up front never goes below this (USD).
CREDITS_MIN_BALANCE_USD=0.01
# Price per 1M tokens charged through to the user (check your provider's price
# list / invoice for AI_MODEL). A provider-reported per-call cost wins if present.
# claude-haiku-4.5 list price: 1 in / 5 out.
AI_PRICE_IN_PER_MTOK=
AI_PRICE_OUT_PER_MTOK=
# Application fee on top of the provider cost (platform revenue), percent.
AI_APP_FEE_PCT=0
